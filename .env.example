# ===== SignBridge AI - Environment Configuration =====
# Copie este arquivo para .env e preencha os valores

# --- Spring Boot ---
SPRING_PROFILE=prod                          # dev | staging | prod

# --- GPU ---
CUDA_VISIBLE_DEVICES=0                       # GPU device index (0, 1, ...)

# --- JWT Authentication ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_256BIT_KEY  # Minimo 256 bits, gere com: openssl rand -base64 32
JWT_EXPIRATION_MS=3600000                    # 1 hora em milissegundos

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://yourdomain.com  # Origens permitidas (separar por virgula)

# --- TLS/HTTPS ---
TLS_ENABLED=true                             # Habilitar HTTPS
TLS_CERT_PATH=/etc/ssl/certs/signbridge.crt  # Caminho do certificado
TLS_KEY_PATH=/etc/ssl/private/signbridge.key  # Caminho da chave privada

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS_PER_MINUTE=60            # Limite de requisicoes por minuto por IP

# --- Logging ---
LOG_LEVEL=INFO                               # TRACE | DEBUG | INFO | WARN | ERROR
